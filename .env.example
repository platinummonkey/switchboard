# Copy to .env and fill in your values before running `podman compose up`.

# Shared secret between switchboard-local and switchboard-server.
# Can be any random string, e.g.: openssl rand -hex 32
SWITCHBOARD_API_KEY=change-me-local-dev-key

# Bearer token for the admin API at http://localhost:9090/admin/api/v1/
# Can be any random string, e.g.: openssl rand -hex 32
SWITCHBOARD_ADMIN_TOKEN=change-me-admin-token

# Upstream LLM provider keys.
# Leave blank to disable a provider (requests to that provider will fail).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Log level for both services (trace | debug | info | warn | error).
RUST_LOG=info

# Postgres password for the local compose environment.
# The DB is enabled automatically via SWITCHBOARD__DATABASE__ENABLED in compose.yaml.
POSTGRES_PASSWORD=changeme
